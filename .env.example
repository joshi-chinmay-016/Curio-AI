# Backend Configuration
PROJECT_NAME="Curio AI"
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=curio_db
POSTGRES_PORT=5432

# Test Database Configuration (Required only for live database integration tests)
# Must point to a dedicated test database whose name contains 'test' (e.g. curio_test_db).
# Never point to your development or production database.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/curio_test_db

# Groq API (Required for Real AI generation)
# Get your key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=2

# Authentication & Security
# Generate a strong 32+ character random secret for production (e.g. `openssl rand -hex 32`)
SECRET_KEY=your-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend Configuration
# Set to 'true' to use the local mock AI simulator without the backend
NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
